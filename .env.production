# Variáveis de Ambiente para Produção (Vercel)
# Configure estas variáveis no painel da Vercel em: Settings > Environment Variables

# URL do servidor ISPFY (sem /webservice/v1 no final)
ISPFY_HOST=https://coopertecisp.com.br:8043

# Token de autenticação da API ISPFY
# IMPORTANTE: Configure este valor no painel da Vercel, não commite no Git!
ISPFY_TOKEN=815e74b02bc6faa371f29274e3d317e0

# Frontend - URL do proxy (usa o próprio domínio da Vercel)
VITE_ISPFY_HOST=/api/ispfy

# Não precisa do token no frontend, ele fica seguro no serverless function
# VITE_ISPFY_TOKEN não é necessário

# Configuração da API WhatsApp (Whapi.Cloud)
VITE_WHAPI_API_KEY=37oG32qZ2Ltk15Pm3aOs9il1JOYfYOdM
VITE_WHAPI_BASE_URL=/api/whapi
VITE_WHAPI_RATE_LIMIT=10
