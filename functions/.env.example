# Configuração de Variáveis de Ambiente (Cloud Functions)
# Copie este arquivo para .env e preencha com suas credenciais reais.
# GEMINI_API_KEY deve ser configurada via Firebase Secrets:
#   firebase functions:secrets:set GEMINI_API_KEY

# ISPFY ERP
ISPFY_HOST=http://seu-servidor-ispfy:8020
ISPFY_TOKEN=your_ispfy_token_here

# IXC Soft ERP
IXC_HOST=https://seu-servidor-ixc/webservice/v1
IXC_TOKEN=id:your_ixc_token_here

# SmartOLT
SMARTOLT_URL=https://seu-subdominio.smartolt.com/api
SMARTOLT_TOKEN=your_smartolt_token_here

# WhatsApp (Whapi.Cloud ou Z-API)
WHAPI_KEY=your_whapi_or_zapi_client_token_here
WHAPI_BASE_URL=https://gate.whapi.cloud
NODE_ENV=production
